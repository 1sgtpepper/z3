(set-logic ALL)
(declare-const p (_ BitVec 2))
(declare-const q (_ BitVec 2))
(declare-fun g (Int) (_ FloatingPoint 3 3))
(declare-fun f ((_ FloatingPoint 3 3)) Int)
(assert (distinct p #b00))
(assert (distinct q #b00))
(assert (distinct p q))
(assert (= (g 0) (fp #b0 #b111 p)))
(assert (= (g 1) (fp #b1 #b111 q)))
(assert (= (f (g 0)) 0))
(assert (= (f (g 1)) 0))
(check-sat)
