(set-logic ALL)
(declare-datatype Box ((BoxBV (bval (_ BitVec 8)))))
(declare-fun x () Box)
(assert (distinct x (BoxBV #x00)))
(assert (= ((_ extract 0 0) (bval x)) #b0))
(assert (= ((_ extract 1 1) (bval x)) #b0))
(assert (= ((_ extract 2 2) (bval x)) #b0))
(assert (= ((_ extract 3 3) (bval x)) #b0))
(assert (= ((_ extract 4 4) (bval x)) #b0))
(assert (= ((_ extract 5 5) (bval x)) #b0))
(assert (= ((_ extract 6 6) (bval x)) #b0))
(assert (= ((_ extract 7 7) (bval x)) #b0))
(check-sat)
