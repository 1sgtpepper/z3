(set-logic ALL)
(declare-const p (_ BitVec 2))
(declare-const q (_ BitVec 2))
(declare-fun f ((_ FloatingPoint 3 3)) Int)
(declare-const a Int)
(assert (> (* a a) 1))
(assert (distinct p #b00))
(assert (distinct q #b00))
(assert (distinct p q))
(assert (= (f (fp #b0 #b111 p)) 0))
(assert (= (f (fp #b1 #b111 q)) 0))
(check-sat)
