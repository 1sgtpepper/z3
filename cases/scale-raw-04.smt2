(set-logic ALL)
(declare-fun f ((_ FloatingPoint 3 3)) Int)
(declare-const s0 (_ BitVec 1))
(declare-const p0 (_ BitVec 2))
(assert (distinct p0 #b00))
(assert (= (f (fp s0 #b111 p0)) 0))
(declare-const s1 (_ BitVec 1))
(declare-const p1 (_ BitVec 2))
(assert (distinct p1 #b00))
(assert (= (f (fp s1 #b111 p1)) 0))
(declare-const s2 (_ BitVec 1))
(declare-const p2 (_ BitVec 2))
(assert (distinct p2 #b00))
(assert (= (f (fp s2 #b111 p2)) 0))
(declare-const s3 (_ BitVec 1))
(declare-const p3 (_ BitVec 2))
(assert (distinct p3 #b00))
(assert (= (f (fp s3 #b111 p3)) 0))
(check-sat)
