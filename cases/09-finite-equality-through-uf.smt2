(set-logic ALL)
(define-fun one () (_ FloatingPoint 8 24)
  (fp #b0 #x7f #b00000000000000000000000))
(declare-fun a () (_ FloatingPoint 8 24))
(declare-fun b () (_ FloatingPoint 8 24))
(declare-fun g ((_ FloatingPoint 8 24)) Int)
(assert (fp.eq a one))
(assert (fp.eq b one))
(assert (distinct (g a) (g b)))
(check-sat)
